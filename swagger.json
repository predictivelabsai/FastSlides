    "securitySchemes": {
      "FastSME API token": {
        "description": "Selected writes require `Authorization: Bearer <token>`. Reads are public. Set FASTSME_API_TOKEN to enable writes.",
        "scheme": "bearer",
        "type": "http"
      }
    }
