# --- FastSlides ------------------------------------------------------------
FASTSLIDES_ADMIN_EMAIL=admin@fastslides.example
FASTSLIDES_ADMIN_PASSWORD=FastSlides2026$
FASTSLIDES_SECRET=
FASTSLIDES_PORT=5013
FASTSLIDES_ENV_LABEL=FastSlides
FASTSLIDES_DB=

# --- AI (deck generation + chat) ------------------------------------------
# MODEL_PROVIDER: xai | openai | anthropic | google.
MODEL_PROVIDER=xai
MODEL_NAME=grok-4-1-fast-reasoning
XAI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Google SSO
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://slides.fastsme.com/auth/google/callback
GOOGLE_ALLOWED_DOMAINS=
GOOGLE_ALLOWED_EMAILS=

# FastSME local accounts and transactional email
FASTSME_AUTH_DB=
FASTSME_PUBLIC_URL=https://slides.fastsme.com
POSTMARK_API_TOKEN=
FROM_EMAIL=info@predictivelabs.ai

# Public reads need no credential; set this to enable bearer-token API writes.
FASTSME_API_TOKEN=
